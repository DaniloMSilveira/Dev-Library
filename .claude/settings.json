{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "claudeMdExcludes": [
    "**/estudos/IA/docs/harness-engineering/exemplos/**"
  ],
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "PowerShell(npm run *)",
      "Bash(node scripts/catalogo.mjs)",
      "Bash(node scripts/verificar-estudos.mjs)",
      "PowerShell(node scripts/catalogo.mjs)",
      "PowerShell(node scripts/verificar-estudos.mjs)",
      "Edit(/estudos/**)",
      "Edit(/rascunhos/**)",
      "WebSearch"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git restore *)",
      "PowerShell(git checkout *)",
      "PowerShell(git rebase *)",
      "PowerShell(git clean *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "PowerShell(npm install *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npm update *)",
      "Bash(rm -rf *)",
      "PowerShell(Remove-Item *)",
      "Bash(terraform *)",
      "Bash(aws *)",
      "Bash(kubectl *)",
      "PowerShell(terraform *)",
      "PowerShell(aws *)",
      "PowerShell(kubectl *)",
      "Edit(/.github/**)",
      "Edit(/.vitepress/**)",
      "Edit(/scripts/**)",
      "Edit(/package.json)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/*.tfvars)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/**)",
      "Read(~/.azure/**)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "PowerShell(terraform apply *)",
      "PowerShell(terraform destroy *)",
      "Bash(kubectl delete *)",
      "PowerShell(kubectl delete *)",
      "Bash(npm publish *)",
      "PowerShell(npm publish *)",
      "Skill(nova-feature)",
      "Skill(nova-feature *)",
      "Skill(revisar)",
      "Skill(revisar *)",
      "Skill(registrar-incidente)",
      "Skill(registrar-incidente *)"
    ]
  }
}
