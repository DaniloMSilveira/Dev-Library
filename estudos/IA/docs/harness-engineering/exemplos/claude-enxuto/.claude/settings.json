{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(ruff check .)",
      "Edit(/app/**)",
      "Edit(/tests/**)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(pip install *)",
      "Edit(/migrations/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(git push *)",
      "Bash(rm -rf *)"
    ]
  }
}
