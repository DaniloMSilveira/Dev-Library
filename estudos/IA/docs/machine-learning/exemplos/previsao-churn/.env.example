# Projeto Desenvolvido na Data Science Academy
#
# .env.example — Template de variáveis de ambiente
#
# Este arquivo serve como referência para criar o arquivo .env real.
# O arquivo .env (com valores reais) NÃO deve ser versionado no Git,
# pois pode conter credenciais sensíveis (12-Factor App).
#
# Para configurar: cp .env.example .env

# Caminho do modelo serializado dentro do container da API
MODEL_PATH=/app/models/churn_model.joblib

# Host e porta do servidor da API (usado internamente pelo Uvicorn)
API_HOST=0.0.0.0
API_PORT=8000

# URL da API usada pelo webapp para comunicação interna via rede Docker.
# O nome "api" é resolvido pelo DNS interno do Docker Compose.
API_URL=http://api:8000

# Nível de logging da aplicação (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
